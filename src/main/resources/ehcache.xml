<?xml version="1.0" encoding="UTF-8"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.ehcache.org/v3"
        xsi:schemaLocation="http://www.ehcache.org/v3 http://www.ehcache.org/schema/ehcache-core-3.0.xsd">
    <service>
        <jsr107:defaults xmlns:jsr107="http://www.ehcache.org/v3/jsr107"/>
    </service>
    <cache alias="movies">
        <key-type>java.lang.Long</key-type>
        <value-type>ru.hipeoplea.is.lab1.models.Movie</value-type>
        <expiry>
            <ttl unit="minutes">30</ttl>
        </expiry>
        <resources>
            <heap unit="entries">500</heap>
        </resources>
    </cache>
    <cache alias="persons">
        <key-type>java.lang.Long</key-type>
        <value-type>ru.hipeoplea.is.lab1.models.Person</value-type>
        <expiry>
            <ttl unit="minutes">30</ttl>
        </expiry>
        <resources>
            <heap unit="entries">500</heap>
        </resources>
    </cache>
    <cache alias="coordinates">
        <key-type>java.lang.Long</key-type>
        <value-type>ru.hipeoplea.is.lab1.models.Coordinates</value-type>
        <expiry>
            <ttl unit="minutes">30</ttl>
        </expiry>
        <resources>
            <heap unit="entries">500</heap>
        </resources>
    </cache>
    <cache alias="locations">
        <key-type>java.lang.Long</key-type>
        <value-type>ru.hipeoplea.is.lab1.models.Location</value-type>
        <expiry>
            <ttl unit="minutes">30</ttl>
        </expiry>
        <resources>
            <heap unit="entries">500</heap>
        </resources>
    </cache>
    <cache alias="importOperations">
        <key-type>java.lang.Long</key-type>
        <value-type>ru.hipeoplea.is.lab1.models.ImportOperation</value-type>
        <expiry>
            <ttl unit="minutes">120</ttl>
        </expiry>
        <resources>
            <heap unit="entries">500</heap>
        </resources>
    </cache>
</config>
